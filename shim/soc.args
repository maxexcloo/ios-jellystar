# Jelly Star hardware facts. Inline comments name the DT node or observation source.
soc_gicd=0x0c000000                          # /interrupt-controller reg[0]
soc_gicd_size=0x40000                        # /interrupt-controller reg[1]
soc_gicr=0x0c040000                          # /interrupt-controller reg[2]
soc_gicr_size=0x200000                       # /interrupt-controller reg[3]
soc_timebase=13000000                        # /timer clock-frequency 0xc65d40
soc_vtimer_intid=27                          # /timer interrupts <1 11 4 ...> -> 16 + PPI 11
soc_cpu_mpidr=0x000,0x100,0x200,0x300,0x400,0x500,0x600,0x700   # /cpus/cpu@NNN reg
soc_dram_rank0_end=0x13ffff000               # reserved-memory/mblock-1-dramc-rk0 (phone, live DT)
soc_dram_rank1_end=0x23ffff000               # reserved-memory/mblock-2-dramc-rk1 (phone, live DT)
soc_dram_kernel_base=0x140000000             # live rank0 training-page address + 0x1000
soc_dram_kernel_size=0xffff0000              # 64 KiB-aligned window below live rank1 training page
soc_lun=sdc
soc_block=4096
soc_lun_bytes=244771160064                     # /sys/block/sdc/size 59758584 x 4096
part_userdata_bytes=244771160064              # sdc60 = 228.0 GiB (blockdev --getsize64)
part_userdata_kib=239034336                   # /proc/partitions column 3 (KiB, NOT sectors)
part_super_bytes=9663676416                   # sdc59 = 9.0 GiB
part_super_kib=9437184
part_expdb_bytes=134217728
soc_ufs=0x11270000                           # /soc/ufshci@11270000 reg[0] size 0x2300
soc_ufs_size=0x2300
soc_ufs_spi=137                              # /soc/ufshci@11270000 interrupts <0 0x89 4>
soc_infracfg_ao=0x10001000                   # /syscon@10001000, reset-controller parent
soc_topckgen=0x10000000                      # /syscon@10000000 (mediatek,mt6789-topckgen)
soc_apmixedsys=0x1000c000                    # /syscon@1000C000
soc_scpsys=0x10006000                        # /power-controller@10006000 (mediatek,mt6789-scpsys)
soc_gpio=0x10005000                          # /soc/gpio@10005000   (pio, phandle &pio)
soc_pwrap=0x10026000                         # /soc/pwrap@10026000  (mediatek,mt6789-pwrap -> MT6366)
soc_toprgu=0x10007000                        # /soc/watchdog@10007000; restart at +0x08, key 0x1971
soc_keypad=0x10010000                        # /soc/kp@10010000     (mediatek,kp volume keys, SPI 106)
soc_disp_pwm=0x1100e000                      # /soc/disp_pwm0@1100e000 (backlight)
soc_mfg_top_config=0x13fbf000                # /soc/gpufreq reg-names[0] mfg_top_config
soc_dsi0=0x14013000                          # /soc/dsi@14013000   (SPI 301)
soc_dsi0_spi=301                             # interrupts <0 0x12d 4>
soc_disp_mutex0=0x14001000                   # /soc/disp_mutex@14001000 (SPI 285)
soc_ovl0=0x1400a000                          # /soc/disp_ovl0@1400a000
soc_mmsys_config=0x14000000                  # /soc/disp_mmsys@14000000
panel_width=480                              # DRM mode + SurfaceFlinger (phone)
panel_height=854
panel_density=220                            # wm density (phone)
panel_driver=panel_ST7701S_Z30043            # lsmod (phone); NOT the TD4330 cmd-mode candidate
panel_mode=vdo                               # video mode: the DSI keeps scanning out, no kick needed
panel_htotal=522
panel_vtotal=894
panel_hbp=16
panel_hfp=16
panel_hsync=10
panel_vbp=18
panel_vfp=20
panel_vsync=2
panel_clock_khz=28000                        # 24000..30000 all land 51-64 Hz; only 28000 gives exactly 60
panel_init_objects=40
panel_init_sym=ST7701S_Z30043_init.d
soc_fb=0xffb0c000                            # /chosen atag,videolfb-fb_base_l (phone)
soc_fb_vramsize=0x4c0000                     # /chosen atag,videolfb-vramSize (phone)
soc_fb_reserved=0x4f3000                     # reserved-memory/mblock-13-framebuffer reg[1] (phone)
soc_fb_lcmname=nt36672e_fhdp_dsi_vdo_60hz_jdi_dphy_drv   # /chosen -- misleading, see panel_driver
soc_lk_lcmname=ST7701S_Z30043_drv            # expdb: LK's own lcm_name (phone, LK boot log)
soc_gpu=0x13000000                           # /soc/mali@13000000 reg[0] size 0x4000
soc_gpu_size=0x4000
soc_gpu_spis=396,397,398,399,400             # /soc/mali@13000000 interrupts
soc_usb=0x11200000                            # /soc/usb0@11200000 (mediatek,mt6789-usb20) SPI 128
soc_usb_phy=0x11f40000                        # /soc/usb-phy@11f40000 (T-PHY, second reg of usb0)
soc_pstore=0x48090000                        # reserved-memory/mblock-10-pstore reg[0]
soc_pstore_size=0xe0000                      # reserved-memory/mblock-10-pstore reg[1]
soc_pmsg=0x48160000                         # Linux 5.10 ramoops: base + mem_size - pmsg_size (live bootargs)
soc_pmsg_size=0x10000                       # /chosen bootargs ramoops.pmsg_size
soc_console=0x4811f000                     # Linux 5.10 ramoops layout; live args, default ftrace_size=0x1000
soc_console_size=0x40000                   # /chosen bootargs ramoops.console_size
soc_aee_kinfo=0x48080000                     # reserved-memory/mblock-9-aee_debug_kinfo
soc_minirdump=0x48170000                     # reserved-memory/mblock-11-minirdump
soc_touch_i2c=0x11e00000                     # dtbo fragment@34 target: /soc/i2c@11e00000 (mediatek,mt6983-i2c)
soc_touch_i2c_size=0x1000                   # /soc/i2c@11e00000 reg[1]
soc_touch_dma=0x10217080                    # /soc/i2c@11e00000 reg[2], APDMA channel
soc_touch_dma_size=0x80                     # /soc/i2c@11e00000 reg[3]
soc_touch_clock=0x11e02000                  # /syscon@11E02000 reg[0], imp_iic_wrap_w
soc_touch_iocfg_lm=0x11e20000               # /soc/pinctrl reg[8], GPIO130/131 input enable
soc_touch_scl_gpio=130                      # pinctrl-mtk-mt6789.h: GPIO130 function1 SCL0
soc_touch_sda_gpio=131                      # pinctrl-mtk-mt6789.h: GPIO131 function1 SDA0
soc_touch_addr=0x2e                          # cap_touch@38 reg; VERIFIED /sys/bus/i2c/devices/0-002e
soc_touch_driver=chsc5xxx_touch              # lsmod; input name "cap_touch" at 11e00000.i2c/i2c-0/0-002e
soc_touch_input=event2                       # /proc/bus/input/devices
soc_touch_hz=400000                          # fragment@34 clock-frequency 0x61a80
soc_touch_irq_gpio=9                         # chipsemi,int-gpio
soc_touch_rst_gpio=152                       # chipsemi,rst-gpio 0x98
soc_touch_irq_type=2                         # interrupts <9 2 9 0>
soc_touch_xres=480                           # tpd-resolution 0x1e0
soc_touch_yres=854                           # tpd-resolution 0x356
soc_touch_max=10                             # tpd-max-touch-num
soc_touch_fw_embedded=upd_data               # .rodata, 85848 B, magic "CHSC" -- in the .ko, not /vendor
soc_touch_fw_bytes=85848
soc_touch_proto=i2c-reg                      # BE32 address 0x2000002c, repeated-start 28-byte read
soc_touch_report_parse=semi_touch_irq_handler_imp  # 28-byte report; five 5-byte records, not DT maximum
